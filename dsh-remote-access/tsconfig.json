{
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationDir": "lib/types",
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["src/**/*.ts"]
}

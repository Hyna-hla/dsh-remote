{
  "name": "dsh-remote-access",
  "version": "2.4.1",
  "description": "DSH 远程互信认证：配对码快速配对、首次配对确认、已配对设备管理、公网域名信任白名单（v2.4.1，写 connection 行 !!js 拼接 trustedHosts 热生效，兼容 --trusted-host）、主机设备信息、只读目录/文件预览、MCP 枚举、远程通道 Bearer token 鉴权（不含微信桥与 cpolar 隧道）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:client": "esbuild src/client.ts --bundle --platform=browser --format=iife --global-name=__ModuleLoader__ --outfile=lib/client.js --banner:js=\"window.__ModuleLoader__ = window.__ModuleLoader__ || { load: () => {} };\" --target=es2020",
    "test": "node --test smoke-test.mjs",
    "prepack": "npm run typecheck && npm run build && npm run build:client && npm test",
    "pack": "npm pack"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "esbuild": "^0.23.0"
  },
  "license": "MIT"
}
